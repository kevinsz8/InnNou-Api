{

  "ConnectionStrings": {
    "InnNouConnection": "Server=localhost\\SQLEXPRESS;Database=InnNou;ConnectRetryCount=0;TrustServerCertificate=True; Integrated Security=true;Encrypt=false"

  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "InnNouAPI",
    "Audience": "InnNouAPIUsers"
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Idempotency": {
    "TtlHours": 24,
    "CleanupIntervalHours": 1
  },
  "FileStorage": {
    "SupplierLogosPath": "UploadedFiles/SupplierLogos",
    "OrderPdfsPath": "UploadedFiles/OrderPdfs",
    "SupplierInvoiceAttachmentsPath": "UploadedFiles/SupplierInvoiceAttachments"
  },
  "Smtp": {
    "Host": "smtp-relay.brevo.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": ""
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}
